# marcap 데이터 저장소 (update_marcap.bat 이 clone/pull)
/marcap
/marcap/

# DART 인증키 (절대 커밋 금지)
/dart_key.txt
/.env

# DART 재무 데이터 (update_dart.bat 이 내려받음)
/dart
/dart/

# 런처 설정 (사용자별 값이라 커밋하지 않는다. launcher_config.default.json 이 기본값)
/launcher_config.json

# 서버 PID (KRX백테스터.vbs 가 생성)
/.server.pid

# 갱신 로그
/logs/

# 파이썬 가상환경 (install.bat 이 생성)
/.venv/
/venv/

# 전략 저장 시 자동 백업 (서버가 생성)
/strategies/.bak/

# 캐시
/cache/
__pycache__/
*.pyc
.pytest_cache/

# 편집기
.vscode/
.idea/
*.swp
.DS_Store
