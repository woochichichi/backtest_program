<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>KRX 백테스터</title>
<hta:application
  id="oHTA"
  applicationname="KRXBacktesterLauncher"
  border="thin"
  borderstyle="normal"
  caption="yes"
  contextmenu="no"
  icon="../assets/krx.ico"
  innerborder="no"
  maximizebutton="no"
  minimizebutton="yes"
  navigable="no"
  scroll="no"
  selection="no"
  showintaskbar="yes"
  singleinstance="yes"
  sysmenu="yes"
  windowstate="normal" />
<link rel="stylesheet" type="text/css" href="launcher.css">
</head>
<body>

<div id="sky">
  <div id="glow"></div>
  <div id="glow2"></div>
  <div id="candles"></div>
  <div id="trend"></div>
  <div id="scrim"></div>
</div>

<div id="app">

  <div id="head">
    <img id="logo" src="../assets/krx.png" alt="">
    <div id="htitle">KRX 백테스터</div>
    <div id="hsub">시작할 준비를 하고 있습니다</div>
  </div>

  <div id="steps">
    <div class="step is-wait" id="s0">
      <div class="mk">
        <div class="mk-idle"><i></i></div>
        <div class="mk-spin"></div>
        <div class="mk-done"><i></i></div>
        <div class="mk-fail">!</div>
        <div class="mk-skip"><i></i></div>
      </div>
      <div class="stt">프로그램 업데이트</div>
      <div class="sts">대기 중</div>
    </div>
    <div class="step is-wait" id="s1">
      <div class="mk">
        <div class="mk-idle"><i></i></div>
        <div class="mk-spin"></div>
        <div class="mk-done"><i></i></div>
        <div class="mk-fail">!</div>
        <div class="mk-skip"><i></i></div>
      </div>
      <div class="stt">시세 데이터</div>
      <div class="sts">대기 중</div>
    </div>
    <div class="step is-wait" id="s2">
      <div class="mk">
        <div class="mk-idle"><i></i></div>
        <div class="mk-spin"></div>
        <div class="mk-done"><i></i></div>
        <div class="mk-fail">!</div>
        <div class="mk-skip"><i></i></div>
      </div>
      <div class="stt">재무 데이터</div>
      <div class="sts">대기 중</div>
    </div>
    <div class="step is-wait" id="s3">
      <div class="mk">
        <div class="mk-idle"><i></i></div>
        <div class="mk-spin"></div>
        <div class="mk-done"><i></i></div>
        <div class="mk-fail">!</div>
        <div class="mk-skip"><i></i></div>
      </div>
      <div class="stt">서버 시작</div>
      <div class="sts">대기 중</div>
    </div>
    <div class="step is-wait" id="s4">
      <div class="mk">
        <div class="mk-idle"><i></i></div>
        <div class="mk-spin"></div>
        <div class="mk-done"><i></i></div>
        <div class="mk-fail">!</div>
        <div class="mk-skip"><i></i></div>
      </div>
      <div class="stt">화면 열기</div>
      <div class="sts">대기 중</div>
    </div>
  </div>

  <div id="logbox">
    <div class="lg" id="lg0">&nbsp;</div>
    <div class="lg l2" id="lg1">&nbsp;</div>
    <div class="lg l3" id="lg2">&nbsp;</div>
  </div>

  <div id="barwrap"><div id="bar"><div id="shine"></div></div></div>

  <div id="foot">
    <div id="fnote">잠시만 기다려 주세요</div>
    <div id="fbtns">
      <button type="button" id="btnCancel">취소</button>
    </div>
    <a class="lnk" id="frecheck" title="신선도 판정을 무시하고 전부 다시 받습니다">전부 다시 확인</a>
    <a class="lnk" id="fcfg" title="포트와 자동 갱신을 바꿉니다">설정</a>
  </div>

</div>

<div class="ov" id="ovAsk">
  <div class="ovin">
    <div class="ovt">시세 데이터가 아직 없습니다</div>
    <div class="ovb">
      백테스트에 쓸 주가 데이터를 한 번은 받아야 합니다.<br>
      크기가 <b>약 1.8GB</b> 라 <b>10~30분</b> 걸립니다. 한 번만 받으면 됩니다.<br>
      나중에 받으려면 <b>update_marcap.bat</b> 을 더블클릭하세요.
    </div>
    <div class="ovf">
      <button type="button" id="askNo">나중에 하기</button>
      <button type="button" class="pri" id="askYes">지금 받기</button>
    </div>
  </div>
</div>

<div class="ov" id="ovDart">
  <div class="ovin">
    <div class="ovt">재무 데이터가 아직 없습니다</div>
    <div class="ovb">
      부채비율, 영업이익 같은 <b>재무 조건</b>으로 종목을 거르려면 필요합니다.<br>
      처음 한 번은 <b>2,400여 건</b>을 부르느라 시간이 걸립니다. 이후에는 훨씬 짧습니다.<br>
      나중에 받아도 됩니다. 그동안은 <b>재무 조건 없이</b> 계산됩니다.
    </div>
    <div class="ovf">
      <button type="button" id="dartNo">나중에 하기</button>
      <button type="button" class="pri" id="dartYes">지금 받기</button>
    </div>
  </div>
</div>

<div class="ov" id="ovRun">
  <div class="ovin">
    <div class="ovt">이미 실행 중입니다</div>
    <div class="ovb">
      <div id="runPort"></div>
      <div id="runVer" class="vchk">새 버전이 있는지 확인하는 중입니다…</div>
      <div id="runLocal" class="vloc"></div>
    </div>
    <div class="ovchk">
      <input type="checkbox" id="runAlways"><label for="runAlways">다음부터 묻지 않고 항상 다시 시작</label>
    </div>
    <div class="ovf">
      <button type="button" id="runClose">닫기</button>
      <button type="button" class="dgr" id="runStop">종료</button>
      <button type="button" id="runOpen">브라우저만 열기</button>
      <button type="button" class="pri" id="runRestart">다시 시작</button>
    </div>
  </div>
</div>

<div class="ov" id="ovPort">
  <div class="ovin">
    <div class="ovt">포트가 겹칩니다</div>
    <div class="ovb" id="portMsg"></div>
    <div class="ovf">
      <button type="button" id="portOther">다른 포트로 켜기</button>
      <button type="button" class="dgr" id="portKill">종료하고 다시 켜기</button>
      <button type="button" class="pri" id="portUse">그 서버 쓰기</button>
    </div>
  </div>
</div>

<div class="ov" id="ovCfg">
  <div class="ovin">
    <div class="ovt">설정</div>
    <div class="ovb">
      <div class="row">
        <span class="lbl">포트 번호</span>
        <input type="text" id="cfgPort" maxlength="5">
        <span class="hint">기본값 8000</span>
      </div>
      <div class="row">
        <input type="checkbox" id="cfgProg"><label for="cfgProg">켤 때 프로그램 자동 업데이트</label>
      </div>
      <div class="row">
        <input type="checkbox" id="cfgQuote"><label for="cfgQuote">켤 때 시세 자동 갱신</label>
      </div>
      <div class="row">
        <span class="lbl">이미 실행 중</span>
        <select id="cfgRun">
          <option value="ask">물어보기</option>
          <option value="restart">항상 다시 시작</option>
          <option value="browser">브라우저만 열기</option>
        </select>
      </div>
      <div id="cfgErr"></div>
    </div>
    <div class="ovf">
      <button type="button" id="cfgCancel">취소</button>
      <button type="button" class="pri" id="cfgSave">저장하고 다시 시작</button>
    </div>
  </div>
</div>

<div class="ov" id="ovDone">
  <div class="ovin">
    <div id="ckglow"></div>
    <div id="bigck"><i></i></div>
    <div id="dtitle">준비 완료</div>
    <div id="dsum">브라우저를 엽니다</div>
  </div>
</div>

<script type="text/javascript" charset="utf-8" src="launcher.js"></script>

</body>
</html>
