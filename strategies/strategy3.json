{
  "schema": "krx-backtest-strategy/v1",
  "id": "strategy3",
  "name": "전략3 — 중단기 스윙 주도주 눌림목",
  "description": "52주 신고가 거래대금 폭발 주도주 탐색 및 20일선 지지 반등 매매",
  "author": "user",
  "created_at": "2026-07-25",
  "enabled": true,
  "market": {
    "country": "KR",
    "asset": "stock",
    "bar": "1d",
    "trade_resolution": "1d"
  },
  "universe": {
    "markets": [
      "KOSPI",
      "KOSDAQ"
    ],
    "exclude": [
      "ETF",
      "ETN",
      "SPAC",
      "PREFERRED",
      "ADMIN_ISSUE",
      "TRADE_HALT"
    ],
    "filters": {
      "market_cap_min_eok": 2000,
      "debt_ratio_max_pct": 200,
      "current_ratio_min_pct": 100,
      "profitable_quarters_min": 4,
      "comment": "재무 3종은 DART 재무 데이터(dart/fundamentals-YYYY.parquet)가 연결됐을 때만 적용된다. 판정은 기준일 시점 as-of 조회다. on_missing=include 는 재무를 알 수 없는 종목을 통과시킨다 — DART 기업목록에 상장폐지 종목이 빠져 있어 exclude 로 두면 망한 회사만 골라 빠지는 생존 편향이 생긴다.",
      "on_missing": "include"
    },
    "reference_day": {
      "rule": "custom",
      "lookback_days": 20,
      "spike_amount_krw_eok": 1000,
      "volume_mult": 5,
      "close_change_min_pct": 15,
      "gap_open_max_pct": 5,
      "when": {
        "op": "and",
        "conditions": [
          {
            "op": ">=",
            "left": "amount",
            "right": {
              "expr": "spike_amount_krw_eok * 100000000"
            }
          },
          {
            "op": ">=",
            "left": "volume",
            "right": {
              "expr": "VMA20 * volume_mult"
            }
          },
          {
            "op": ">=",
            "left": "close",
            "right": {
              "expr": "prev.close * (1 + close_change_min_pct / 100)"
            }
          },
          {
            "op": "<",
            "left": "open",
            "right": {
              "expr": "prev.close * (1 + gap_open_max_pct / 100)"
            }
          },
          {
            "op": ">=",
            "left": "close",
            "right": "HIGH252"
          },
          {
            "op": ">",
            "left": "prev.close",
            "right": "prev.MA20"
          }
        ]
      },
      "comment": "전부 AND. 거래대금 1,000억 초과 · 거래량 20일평균 5배 이상 · 종가 전일대비 +15% 이상 · 시가 갭상승 +5% 미만 · 52주(252봉) 종가 신고가 · 전일 종가가 20일선 위."
    },
    "condition": "none",
    "valid_days_after_reference": 15
  },
  "entries": [
    {
      "id": "B1",
      "label": "진입 (20일선 지지 반등 · 종가 매수)",
      "pullback_amount_divisor": 3,
      "when": {
        "op": "and",
        "conditions": [
          {
            "op": "<=",
            "left": "low",
            "right": "MA20"
          },
          {
            "op": ">",
            "left": "close",
            "right": "MA20"
          },
          {
            "op": ">",
            "left": "MACD_MAIN",
            "right": 0
          },
          {
            "op": "<=",
            "left": "amount",
            "right": {
              "expr": "ref.amount / pullback_amount_divisor"
            }
          }
        ]
      },
      "price": "close",
      "size_pct": 100,
      "size_of": "planned_position",
      "comment": "눌림목 조건(일일 거래대금 <= 기준일 거래대금 x 1/3)을 4번째 AND 조건으로 함께 판정한다. 기준일 후 valid_days_after_reference(15거래일) 안에서만 유효하다."
    }
  ],
  "exits": [
    {
      "id": "SL",
      "label": "손절 (진입일 저가 이탈 또는 20일선 이탈)",
      "type": "stop_loss",
      "when": {
        "op": "or",
        "conditions": [
          {
            "op": "<",
            "left": "close",
            "right": "entry.low"
          },
          {
            "op": "<",
            "left": "close",
            "right": "MA20"
          }
        ]
      },
      "price": "close",
      "size_pct": 100
    },
    {
      "id": "TP1",
      "label": "1차 익절 (평단 +7% 도달 · 50%)",
      "type": "take_profit",
      "target_pct": 7,
      "when": {
        "op": ">=",
        "left": "high",
        "right": {
          "expr": "position.avg_price * (1 + target_pct / 100)"
        }
      },
      "price": {
        "expr": "position.avg_price * (1 + target_pct / 100)"
      },
      "size_pct": 50
    },
    {
      "id": "TP2",
      "label": "2차 익절 (5일선 이탈 · 잔량 전량)",
      "type": "signal",
      "when": {
        "op": "<",
        "left": "close",
        "right": "MA5"
      },
      "price": "close",
      "size_pct": 100
    },
    {
      "id": "TIME",
      "label": "시간 청산 (보유 7일 경과 & 수익률 +3% 미만)",
      "type": "time_exit",
      "hold_days": 7,
      "pnl_min_pct": 3,
      "when": {
        "op": "and",
        "conditions": [
          {
            "op": ">=",
            "left": "position.hold_days",
            "right": "hold_days"
          },
          {
            "op": "<",
            "left": "position.pnl_pct",
            "right": "pnl_min_pct"
          }
        ]
      },
      "price": "close",
      "size_pct": 100
    }
  ],
  "exit_priority": [
    "SL",
    "TIME",
    "TP1",
    "TP2"
  ],
  "indicators": [
    {
      "key": "MA20",
      "type": "SMA",
      "period": 20,
      "source": "close",
      "plot": true,
      "color": "#ffb74d"
    },
    {
      "key": "MA5",
      "type": "SMA",
      "period": 5,
      "source": "close",
      "plot": true,
      "color": "#4dd0e1"
    },
    {
      "key": "VMA20",
      "type": "SMA",
      "period": 20,
      "source": "volume",
      "plot": false
    },
    {
      "key": "HIGH252",
      "type": "HIGHEST",
      "period": 252,
      "source": "close",
      "plot": true,
      "color": "#ba68c8"
    },
    {
      "key": "MACD_MAIN",
      "type": "MACD",
      "fast": 12,
      "slow": 26,
      "signal": 9,
      "field": "macd",
      "plot": false
    }
  ],
  "portfolio": {
    "initial_capital_manwon": 10000,
    "max_positions": 10,
    "position_sizing": "equal_weight",
    "allow_duplicate_symbol": false
  },
  "execution": {
    "resolution": "1d",
    "fill_model": "touch",
    "same_day_exit": "loss_only",
    "slippage_pct": 0.1,
    "fee_pct": 0.23
  },
  "period": {
    "start": "2016-01-01",
    "end": "auto"
  },
